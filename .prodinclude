# Files and directories to promote from dev → prod
# Used by utils/promote_to_prod.sh
# Prod = Railway deployment (visualization dashboard + API)
#
# Superset of .publicinclude plus prod-specific content.
# Deployment files (Procfile, railway.toml, .railwayignore, other/railway/)
# live directly on the prod branch and are NOT managed by promotion.

# ── Pipeline ──
core/
extraction/
inference/

# ── Utilities ──
utils/

# ── Visualization ──
visualization/

# ── Config ──
config/paths.yaml
config/models/

# ── Datasets ──
datasets/traits/starter_traits/
datasets/inference/starter_prompts/
# Active traits referenced by viz_findings:
datasets/traits/rm_hack/

# ── Analysis ──
analysis/

# ── Docs (same as .publicinclude) ──
docs/main.md
docs/extraction_guide.md
docs/inference_guide.md
docs/steering_guide.md
docs/trait_dataset_creation.md
docs/architecture.md

# ── Prod-only: served by dashboard ──
docs/overview.md
docs/methodology.md
docs/viz_findings/

# ── MkDocs site (built at deploy time, served at /docs) ──
docs/mkdocs/
docs/overrides/
mkdocs.yml

# ── Root files ──
README.md
# CLAUDE.main.md is renamed to CLAUDE.md by promote_to_prod.sh — the dev
# CLAUDE.md references @docs/dev.md which doesn't ship to prod.
CLAUDE.main.md
LICENSE
requirements.txt
pyproject.toml
.gitignore
.env.example
experiments/.gitkeep

# ── Steering ──
steering/
